# Add these to .env.local (never commit real values).

# --- Existing (already in April scaffold) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- New for the blog + research bot ---

# Service-role key ONLY on the server. Used by the research bot to insert drafts
# regardless of RLS. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API key for the daily research draft generator.
# Rotate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Editorial email — draft-ready notifications go here.
EDITOR_EMAIL=editorial@inovers.in

# Cron secret — Vercel adds this header when calling /api/cron/*.
# Match it to whatever you set in vercel.json's `crons` block.
CRON_SECRET=change-me-to-a-long-random-string

# Public site URL — used in canonical links, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://inovers.in
